{
  "name": "menupilot-auth",
  "version": "1.0.0",
  "private": true,
  "description": "menuPilot authentication service (Better Auth on Hono) sharing the Laravel MySQL database.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@better-auth/core": "1.7.7",
    "@hono/node-server": "2.1.1",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.7",
    "hono": "4.13.9",
    "kysely": "0.29.6",
    "mysql2": "3.24.4",
    "nodemailer": "10.0.10"
  },
  "devDependencies": {
    "otpauth": "9.5.2"
  }
}
