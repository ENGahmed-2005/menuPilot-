# auth/.env — local development (`npm run dev` reads it). docs/auth.md lists every setting.

# Required: the same value in Laravel's .env lets Laravel check cookie signatures.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Laravel's database (same names as backend/.env), or DATABASE_URL=mysql://user:pass@host:3306/db
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=menupilot
DB_USERNAME=root
DB_PASSWORD=

PORT=3005

# The frontends that proxy /api/auth here (exact hosts, never a *.vercel.app wildcard), and the fallback for links.
# AUTH_ALLOWED_HOSTS=menupilot.vercel.app,frontend-production-351d.up.railway.app,localhost:5173
# AUTH_FALLBACK_URL=http://localhost:5173

# E-mail (confirmation + password reset). Without SMTP_HOST no e-mail is sent and
# the app offers the WhatsApp reset request instead. Locally, MAIL_TRANSPORT=log
# prints the e-mails (with their links) to the console.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM_ADDRESS=no-reply@menupilot.app
# MAIL_FROM_NAME=menuPilot
MAIL_TRANSPORT=log

# Google sign-in (existing accounts only). Redirect URI: <frontend>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Client IP for rate limits: header and how many proxies append to it (see docs/auth.md).
# AUTH_CLIENT_IP_HEADER=x-forwarded-for
# AUTH_PROXY_HOPS=1
