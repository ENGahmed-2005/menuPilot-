APP_NAME=menuPilot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Public URL of the React app (QR codes and e-mail links point here).
# Production: https://<your-frontend-domain>
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=menupilot
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime (docs/realtime.md): "null" = screens refresh on a timer; "realtime" = Laravel Reverb.
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=file

# log (local, writes to storage/logs) | smtp | mailersend (API token)
MAIL_MAILER=log
# MailerSend API token (only with MAIL_MAILER=mailersend). Never commit it.
MAILERSEND_API_KEY=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Platform admin (created by AdminSeeder / php artisan menupilot:create-admin).
# Set these in the hosting environment, never commit real values.
ADMIN_NAME="menuPilot Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to true for ONE deploy to rotate the admin password, then remove.
ADMIN_RESET_PASSWORD=false

# Subscription payments by bank transfer (shown to owners on the plan page).
SUBSCRIPTION_CURRENCY=USD
SUBSCRIPTION_BANK_NAME="بنك فلسطين"
SUBSCRIPTION_BANK_ACCOUNT_NAME=
SUBSCRIPTION_BANK_ACCOUNT_NUMBER=
SUBSCRIPTION_BANK_IBAN=
SUBSCRIPTION_BANK_BRANCH=
SUBSCRIPTION_WHATSAPP=+970597401925
