# Same origin: vite.config.js proxies /api/auth to the auth service (:3005)
# and the rest of /api to Laravel (:8000).
VITE_API_BASE_URL=/api
VITE_USE_MOCKS=false
# Local development on Windows: "polling" avoids SSE blocking `php artisan serve`.
# Leave unset (or "sse") in production.
VITE_REALTIME_MODE=polling
VITE_POLL_INTERVAL_MS=3000
